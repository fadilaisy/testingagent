# ROAMR server settings. Copy to .env for local use, or set these as
# variables on your host. On Fly, NODE_ENV, PORT, DATABASE_FILE and
# TRUST_PROXY are in fly.toml; set the rest with `fly secrets set`.
# Nothing here is a secret except SIGNUP_CODE: sessions are random tokens stored in the database, so there is no
# signing key to manage, and premium/email/push have no provider keys yet.

# "production" turns on Secure cookies and turns off demo data/demo mode.
NODE_ENV=production

# Port to listen on (fly.toml sets 3001).
PORT=3001

# SQLite file. Must be on a persistent volume in production, or every
# deploy starts with an empty database. Required when NODE_ENV=production.
DATABASE_FILE=/data/jalur.db

# Number of proxy hops in front of the app, so rate limits see the real
# client IP. 2 for Vercel in front of Fly (set in fly.toml); 1 for a
# single proxy such as Fly alone or nginx.
TRUST_PROXY=2

# Comma-separated emails that get the admin dashboard (/admin). Without it,
# the first account registered becomes admin.
ADMIN_EMAILS=you@example.com

# Closed alpha: people need this code to create an account. Share invite
# links as https://<your-domain>/register?invite=<code>. Leave empty to
# let anyone sign up.
SIGNUP_CODE=change-me

# Optional overrides (defaults shown for production):
# SEED=0              1 loads demo accounts (@roamr.test, password123). Never for alpha.
# DEMO_MODE=0         1 relaxes check-in time and location rules for testing away from the route.
# INSECURE_COOKIES=0  1 allows cookies over plain http (local testing only).

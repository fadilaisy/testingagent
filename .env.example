# ROAMR server settings. Every variable the server reads is listed here
# (server/src/config.js); the web app reads none, because it calls /api on
# its own domain (see docs/DEPLOY.md, "API URL, CORS and cookies").
#
# Local: copy this file to .env in the repo root and uncomment what you
# need. `npm run dev`, `npm start` and `npm run seed` load it if it exists.
# Variables already set in the shell win over .env. Never commit .env.
#
# Fly: NODE_ENV, PORT, DATABASE_FILE and TRUST_PROXY are in fly.toml; set the
# rest with `fly secrets set`. Secrets: SIGNUP_CODE, MIDTRANS_SERVER_KEY,
# GOOGLE_CLIENT_SECRET, RESEND_API_KEY. Sessions are random tokens stored in
# the database, so there is no JWT or session signing key to manage. Premium
# and push have no provider yet. Vercel needs no variables.

# --- Runtime -------------------------------------------------------------
# "production" turns on Secure cookies and turns off demo data/demo mode.
# Leave unset locally.
# NODE_ENV=production

# Port to listen on (default 3001, which the Vite dev proxy expects).
# PORT=3001

# SQLite file. Default server/data/roamr.db. Required when
# NODE_ENV=production, and must be on a persistent volume there or every
# deploy starts with an empty database. Fly uses /data/jalur.db.
# DATABASE_FILE=/data/jalur.db

# Number of proxy hops in front of the app, so rate limits see the real
# client IP. 2 for Vercel in front of Fly (set in fly.toml); 1 for a
# single proxy such as Fly alone or nginx. Unset locally.
# TRUST_PROXY=2

# --- Access --------------------------------------------------------------
# Comma-separated emails that get the admin dashboard (/admin). Without it,
# the first account registered becomes admin.
# ADMIN_EMAILS=you@example.com

# Closed alpha: people need this code to create an account. Share invite
# links as https://<your-domain>/register?invite=<code>. Unset lets anyone
# sign up.
# SIGNUP_CODE=change-me

# --- Public address ------------------------------------------------------
# Site address without a trailing slash. Used for the Midtrans return link
# and the link in reset emails. Required in production when
# MIDTRANS_SERVER_KEY or RESEND_API_KEY is set.
# PUBLIC_URL=https://roamr.id

# --- Paid events (Midtrans Snap) -----------------------------------------
# Without MIDTRANS_SERVER_KEY, paid events use manual confirmation only
# (organizer gives transfer instructions and confirms each payment in the
# app). With it, participants pay on Midtrans (QRIS, e-wallets, virtual
# accounts, cards) and are confirmed automatically. Only the server key is
# used; the client key is not needed because Snap runs as a redirect.
# Use the sandbox key (SB-Mid-server-...) with MIDTRANS_PRODUCTION=0, then
# the production key with MIDTRANS_PRODUCTION=1 (the server refuses a
# sandbox key in production mode).
# In the Midtrans dashboard set Payment Notification URL to
#   https://<your-domain>/api/payments/midtrans/notification
# MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxx
# MIDTRANS_PRODUCTION=0

# --- Continue with Google ------------------------------------------------
# Set all three or none. Create a Web OAuth client in Google Cloud Console
# and add the callback as an authorized redirect URI (see docs/DEPLOY.md).
# The callback must end with /api/auth/google/callback; https in production.
# Locally use http://localhost:5173/api/auth/google/callback.
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx
# GOOGLE_CALLBACK_URL=https://roamr.id/api/auth/google/callback

# --- Password reset email (Resend) ---------------------------------------
# Set both or none. Without them, reset links are only written to the
# server log (and shown on screen outside production).
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM="ROAMR <no-reply@roamr.id>"

# --- Development and testing switches ------------------------------------
# Defaults: on outside production, off in production.
# SEED=1              1 loads demo accounts (@roamr.test, password123). Never for alpha.
# DEMO_MODE=1         1 relaxes check-in time and location rules for testing away from the route.
# INSECURE_COOKIES=0  1 allows cookies over plain http in production (local testing only).

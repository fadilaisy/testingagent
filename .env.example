# ROAMR server settings. Copy to .env and fill in what you need; empty means off or default.

# "production" on the server; leave empty locally.
NODE_ENV=
# Port the server listens on (default 3001).
PORT=
# postgres://user:password@host:5432/db, or a folder for an embedded PGlite database
# (default server/data/pglite; a postgres:// URL is required in production).
DATABASE_URL=
# Number of proxies in front of the app (1 behind Caddy on AWS).
TRUST_PROXY=

# Comma-separated emails that get the admin dashboard.
ADMIN_EMAILS=
# Invite code required to sign up (empty: anyone can sign up).
SIGNUP_CODE=
# Public site address, e.g. https://roamr.id (needed for Midtrans and reset emails).
PUBLIC_URL=

# Midtrans server key, SB-Mid-server-... for sandbox (empty: manual payments only).
MIDTRANS_SERVER_KEY=
# 1 to use Midtrans production with the production key.
MIDTRANS_PRODUCTION=

# Google OAuth client ID (all three Google keys or none).
GOOGLE_CLIENT_ID=
# Google OAuth client secret.
GOOGLE_CLIENT_SECRET=
# Google redirect URI ending in /api/auth/google/callback (local: http://localhost:5173/api/auth/google/callback).
GOOGLE_CALLBACK_URL=

# Resend API key for password-reset emails (empty: links only go to the server log).
RESEND_API_KEY=
# Sender for those emails, e.g. "ROAMR <no-reply@roamr.id>".
EMAIL_FROM=

# 1 loads demo accounts, 0 skips them (default: on locally, off in production).
SEED=
# 1 relaxes check-in time and location rules for testing (default: on locally, off in production).
DEMO_MODE=
# 1 allows cookies over plain http in production (local testing only).
INSECURE_COOKIES=
